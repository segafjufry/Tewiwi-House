# Salin ke Railway Environment Variables dan isi semua nilai di bawah.

NODE_ENV=production

# ---- Database PostgreSQL (Supabase) ----
DATABASE_URL=postgresql://user:password@host:5432/postgres
DATABASE_SSL=require
DB_POOL_MAX=5

# ---- Server ----
PORT=3000
HOST=0.0.0.0
TRUST_PROXY=1

# ---- Auth ----
# Generate: node -p "require('crypto').randomBytes(32).toString('hex')"
ADMIN_API_KEY=your-random-key-min-24-chars

# ---- CORS (URL frontend Vercel) ----
CORS_ORIGIN=https://your-frontend.vercel.app

# ---- Forecast Python Service (URL Railway service forecast) ----
FORECAST_API_URL=https://your-forecast-service.up.railway.app

# ---- Migrasi otomatis ----
AUTO_MIGRATE=true
SEED_BASE_DATA=false

# ---- Pembayaran ----
PAYMENT_BANK_NAME=Mandiri
PAYMENT_ACCOUNT_NUMBER=
PAYMENT_ACCOUNT_NAME=
ADMIN_WHATSAPP=

# ---- Opsional: Claude AI untuk production brief ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# ---- Rate limit ----
RATE_LIMIT_ORDERS=10
MIN_LEAD_DAYS=2
